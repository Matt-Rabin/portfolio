---
import Base from '../layouts/Base.astro';
import HeroModel from '../components/HeroModel.astro';

const linkedin = 'https://www.linkedin.com/in/matthew-rabin/';

const timelineEntries = [
  {
    role: 'MSE Student: Integrated Product Design',
    org: 'University of Pennsylvania',
    period: '2024 – Present',
    description: 'Pursuing an MSE in Integrated Product Design with a robotics focus. The program blends the full design process with business and engineering: from user research and ideation through prototyping, manufacturing, and market validation. In addition to my studies, I have been TAing product design at Wharton for both years, and doing research in the GRASP Lab working on novel actuator hardware with Dr. Mark Yim.',
  },
  {
    role: 'Engineer',
    org: 'Belcan / Rolls-Royce Naval Marine',
    period: '2024',
    description: 'Contracted into Rolls-Royce\'s naval division and built multiple MATLAB automation tools.',
  },
  {
    role: 'Robotics Engineer',
    org: 'Carbon Origins Inc.',
    period: '2021 – 2023',
    description: 'Joined a VR teleoperation robotics startup as an intern during my senior year doing industrial design and creating an omnidirectional drive for a food delivery robot. Stayed on full time, leading hardware upgrades across the active fleet and eventually helping run operations for a pilot program in Spain. Started developing the hardware for the next product, a Bobcat vehicle controlled by our software.',
  },
  {
    role: 'B.S. Mechanical Engineering',
    org: 'Case Western Reserve University',
    period: '2018 – 2022',
    description: 'Studied mechanical engineering in undergrad, designing everything from motorcycle engines to finger prosthetics, and graduated in 2022.',
  },
];
---

<Base title="Work by Matthew Rabin">
  <section class="about section">
    <div class="container">
      <div class="about-hero">
        <div class="about-hero-text">
          <h1 class="about-heading">About</h1>
          <p class="about-bio">
            I'm Matt, a New Englander engineer and product designer based in Philadelphia, building products from the inside out (with a particular focus on robotics and embedded systems). I care as much about how something feels to use as how it's built, which means I spend equal time on tolerances and interactions. When I'm not building, I'm deep in sports statistics, instant photography, or convincing people that geography is interesting.
          </p>
        </div>
        <div class="about-hero-portrait">
          <HeroModel />
        </div>
      </div>

      <h2 class="about-subheading">Timeline</h2>

      <div class="timeline">
        {timelineEntries.map((entry) => (
          <div class="timeline-entry">
            <span class="timeline-period">{entry.period}</span>
            <div class="timeline-details">
              <h3 class="timeline-role">{entry.role}</h3>
              <p class="timeline-org">{entry.org}</p>
              {entry.description && (
                <p class="timeline-desc">{entry.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <a href="/contact" class="resume-link">Resume &rarr;</a>

      <h2 class="about-subheading">Links</h2>

      <div class="about-links">
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="about-link">
          <span class="about-link-label">LinkedIn</span>
          <span class="about-link-value">linkedin.com/in/matthew-rabin</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .about-hero-portrait {
    display: flex;
    justify-content: flex-end;
    min-height: min(80vh, 42rem);
  }

  .about-heading {
    margin-bottom: var(--space-md);
  }

  .about-bio {
    font-weight: 200;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.7);
    max-width: 40rem;
  }

  .about-subheading {
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: var(--space-lg);
  }

  .resume-link {
    display: inline-block;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    border-bottom: 2px solid var(--color-text);
    padding-bottom: 0.15rem;
    margin-bottom: var(--space-xl);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .timeline-entry {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .timeline-entry:last-child {
    border-bottom: none;
  }

  .timeline-period {
    font-weight: 300;
    font-size: 0.875rem;
    color: rgba(0, 0, 0, 0.5);
    padding-top: 0.2rem;
  }

  .timeline-role {
    font-weight: 700;
    font-size: 1.0625rem;
    margin-bottom: 0.2rem;
  }

  .timeline-org {
    font-weight: 400;
    font-size: 0.9375rem;
    color: rgba(0, 0, 0, 0.6);
    margin-bottom: var(--space-xs);
  }

  .timeline-desc {
    font-weight: 200;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.5);
  }

  .about-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .about-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .about-link-label {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.4);
  }

  .about-link-value {
    font-weight: 400;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .about-hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-hero-portrait {
      justify-content: center;
      order: -1;
    }

    .about-bio {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 480px) {
    .timeline-entry {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>
