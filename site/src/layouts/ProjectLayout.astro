---
import Base from './Base.astro';

interface Props {
  title: string;
}

const { title: _title } = Astro.props;
---

<Base title="Work by Matthew Rabin">
  <article class="project-page">
    <slot />
  </article>
</Base>

<style>
  .project-page {
    padding-bottom: var(--space-xl);
  }
</style>
