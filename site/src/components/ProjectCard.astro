---
interface Props {
  slug: string;
  title: string;
  subtitle: string;
  heroImage: ImageMetadata;
}

import { Image } from 'astro:assets';

const { slug, title, subtitle, heroImage } = Astro.props;
---

<a href={`/projects/${slug}`} class="project-card">
  <div class="card-image">
    <Image src={heroImage} alt={title} width={600} />
  </div>
  <div class="card-info">
    <h3 class="card-title">{title}</h3>
    <p class="card-subtitle">{subtitle}</p>
  </div>
</a>

<style>
  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .project-card:hover {
    opacity: 0.85;
  }

  .card-image {
    overflow: hidden;
    margin-bottom: var(--space-sm);
    background: #f5f5f5;
    border-radius: 1rem;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-title {
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .card-subtitle {
    font-weight: 300;
    font-size: 0.875rem;
    color: rgba(0, 0, 0, 0.6);
  }
</style>
