---
const linkedin = 'https://www.linkedin.com/in/matthew-rabin/';
---

<footer class="footer">
  <div class="footer-inner container">
    <span class="footer-copy">&copy; {new Date().getFullYear()} Matthew Rabin</span>
    <div class="footer-links">
      <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding: var(--space-md) 0;
    margin-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
    font-weight: 300;
    color: rgba(0, 0, 0, 0.5);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
</style>
