---
import { Image } from 'astro:assets';
import portrait from '../assets/images/2xImages/StylizedPortrait@2x.webp';
---

<section class="hero">
  <div class="hero-inner container">
    <div class="hero-text">
      <h1 class="hero-title">Matthew Rabin</h1>
      <p class="hero-role"><em>Engineer and Designer</em></p>
      <p class="hero-tagline">
        I'm Matt, a New Englander engineer and product designer based in Philadelphia, building products from the inside out (with a particular focus on robotics and embedded systems). I care as much about how something feels to use as how it's built, which means I spend equal time on tolerances and interactions. When I'm not building, I'm deep in sports statistics, instant photography, or convincing people that geography is interesting.
      </p>
      <p class="hero-cta">Let's build something worth using.</p>
    </div>
    <div class="hero-portrait">
      <Image src={portrait} alt="Stylized portrait of Matthew Rabin" width={560} />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 3.5rem);
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .hero-title {
    font-weight: 100;
    font-size: clamp(3rem, 7vw, 5.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: var(--space-lg);
  }

  .hero-role {
    font-weight: 200;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    margin-bottom: var(--space-lg);
  }

  .hero-tagline {
    font-weight: 200;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    max-width: 38rem;
  }

  .hero-cta {
    font-weight: 200;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    line-height: 1.7;
  }

  .hero-portrait {
    display: flex;
    justify-content: flex-end;
  }

  .hero-portrait img {
    max-height: 80vh;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-portrait {
      justify-content: center;
      order: -1;
    }

    .hero-tagline {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
