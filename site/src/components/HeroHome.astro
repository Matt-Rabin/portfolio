---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/2xImages/HomeAmbiHero.webp';
---

<section class="hero">
  <div class="container">
    <h1 class="hero-title">Matthew Rabin</h1>
  </div>
  <div class="hero-image">
    <Image src={heroImage} alt="Ambi hero" width={2400} quality={100} />
  </div>
  <div class="container">
    <p class="hero-statement"><span class="pill pill-engineer">Engineer</span> and <span class="pill pill-designer">Designer</span> specialized in designing <span class="highlight">products</span>, <span class="highlight">interfaces</span>, <span class="highlight">hardware</span> and <span class="highlight">robotics</span>, with a focus on making things that work <span class="highlight">beautifully</span>.</p>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .hero-title {
    font-weight: 100;
    font-size: clamp(3.4rem, 8vw, 6.2rem);
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    margin-bottom: var(--space-md);
  }

  .hero-image {
    width: 100%;
    margin-bottom: var(--space-md);
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .pill {
    display: inline;
    border-radius: 999px;
    padding: 0.1em 0.45em;
    margin: 0 0.05em;
  }

  .pill-designer {
    background-color: #009edf;
    color: #000000;
  }

  .pill-engineer {
    background-color: #ffb900;
    color: #000000;
  }

  .hero-statement {
    font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 5rem);
    line-height: 1.15;
    color: #c2c2c2;
  }

  .hero-statement .highlight {
    color: #000000;
  }
</style>
