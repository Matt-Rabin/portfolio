---
import { Image } from 'astro:assets';

interface Props {
  images: Record<string, ImageMetadata>;
  projectId: string;
}

const { images, projectId } = Astro.props;

function img(filename: string) {
  return images[`/src/assets/images/${projectId}/${filename}`];
}
---

<div class="bb-results">
  <p class="body-text">The robot demonstrated reliable wall-following and stable manual control during testing and competition, with robustness prioritized over more complex autonomous behaviors. Final deliverables included a fully functional robot, detailed CAD drawings, electrical schematics, and embedded software.</p>

  <div class="image-grid">
    {img('image 67@2x.webp') && <div class="img-large-left"><Image loading="lazy" src={img('image 67@2x.webp')} alt="Completed battlebot" width={700} /></div>}
    <div class="right-col">
      {img('image 58@2x.webp') && <div class="img-top-right"><Image loading="lazy" src={img('image 58@2x.webp')} alt="Robot detail" width={600} /></div>}
      <div class="bottom-pair">
        {img('image 65@2x.webp') && <Image loading="lazy" src={img('image 65@2x.webp')} alt="Competition photo" width={350} />}
        {img('image 63@2x.webp') && <Image loading="lazy" src={img('image 63@2x.webp')} alt="Robot in action" width={350} />}
      </div>
    </div>
  </div>
</div>

<style>
  .bb-results {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .body-text {
    font-weight: 200;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    line-height: 1.7;
    text-align: justify;
    max-width: 65ch;
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .img-large-left img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .right-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .img-top-right img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .bottom-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .bottom-pair img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .image-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
