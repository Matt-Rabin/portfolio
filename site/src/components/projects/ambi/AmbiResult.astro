---
import { Image } from 'astro:assets';

interface Props {
  images: Record<string, ImageMetadata>;
  projectId: string;
}

const { images, projectId } = Astro.props;

function img(filename: string) {
  return images[`/src/assets/images/${projectId}/${filename}`];
}
---

<div class="ambi-result">
  <div class="top-section">
    <p class="body-text">The prototype was SLA-printed and wired so the ball completed a circuit by bridging two pins. Tests confirmed the interaction felt intuitive to users, but they wanted clearer cues for which sound was active. These insights led to plans to make larger divots, visible engraving, and a smaller overall form for the next iteration.</p>
    <div class="top-images">
      {img('DisectedView@2x.webp') && <div class="img-dissected"><Image src={img('DisectedView@2x.webp')} alt="Dissected view of prototype" width={500} /></div>}
      {img('a83a3003-f0d2-4c52-94c8-2937e9ff4c8f@2x.webp') && <div class="img-small-top"><Image src={img('a83a3003-f0d2-4c52-94c8-2937e9ff4c8f@2x.webp')} alt="Prototype in context" width={400} /></div>}
    </div>
  </div>

  <div class="bottom-section">
    {img('IMG_7496 3@2x.webp') && <div class="img-large"><Image src={img('IMG_7496 3@2x.webp')} alt="Prototype on surface" width={600} /></div>}
    <div class="bottom-right">
      {img('81710707-92bc-4c06-97d6-26c8e97f1145@2x.webp') && <div class="img-mid"><Image src={img('81710707-92bc-4c06-97d6-26c8e97f1145@2x.webp')} alt="Prototype detail" width={500} /></div>}
      <div class="small-stack">
        {img('IMG_8147 3@2x.webp') && <Image src={img('IMG_8147 3@2x.webp')} alt="Testing the prototype" width={400} />}
        {img('IMG_8149 3@2x.webp') && <Image src={img('IMG_8149 3@2x.webp')} alt="Prototype in use" width={400} />}
      </div>
    </div>
  </div>
</div>

<style>
  .ambi-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .body-text {
    font-weight: 200;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    line-height: 1.7;
    text-align: justify;
  }

  .top-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .top-images {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-sm);
  }

  .top-images img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .bottom-section {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-sm);
  }

  .img-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bottom-right {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-sm);
  }

  .img-mid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .small-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .small-stack img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .top-section,
    .bottom-section,
    .top-images,
    .bottom-right {
      grid-template-columns: 1fr;
    }

    .small-stack {
      flex-direction: row;
    }

    .small-stack img {
      width: 50%;
    }
  }
</style>
