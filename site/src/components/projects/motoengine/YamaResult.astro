---
import { Image } from 'astro:assets';

interface Props {
  images: Record<string, ImageMetadata>;
  projectId: string;
}

const { images, projectId } = Astro.props;

function img(filename: string) {
  return images[`/src/assets/images/${projectId}/${filename}`];
}
---

<div class="yama-result">
  <div class="top-section">
    <p class="body-text">The final deliverable was a comprehensive technical report supported by a fully detailed CAD engine assembly with integrated analysis. While most of my work focused on the crankshaft, I also contributed significantly to the case and valvetrain. The project emphasized designing with analysis from the outset, using early FEA to guide tradeoffs between strength, weight, and manufacturability. Working within a large team highlighted how tightly coupled mechanical decisions are in complex systems, where changes to one component propagate throughout the design.</p>
    {img('image 5@2x.webp') && <div class="img-exploded"><Image loading="lazy" src={img('image 5@2x.webp')} alt="Exploded CAD assembly" width={600} /></div>}
  </div>

  {img('EngineWireframe 1@2x.webp') && (
    <div class="img-wireframe">
      <Image loading="lazy" src={img('EngineWireframe 1@2x.webp')} alt="Engine wireframe assembly" width={1000} />
    </div>
  )}
</div>

<style>
  .yama-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .body-text {
    font-weight: 200;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    line-height: 1.7;
    text-align: justify;
  }

  .top-section {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .img-exploded img {
    width: 100%;
    height: auto;
  }

  .img-wireframe {
    width: 100%;
  }

  .img-wireframe img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .top-section {
      grid-template-columns: 1fr;
    }
  }
</style>
