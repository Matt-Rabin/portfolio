---
import { Image } from 'astro:assets';

interface Props {
  images: Record<string, ImageMetadata>;
  projectId: string;
}

const { images, projectId } = Astro.props;

function img(filename: string) {
  return images[`/src/assets/images/${projectId}/${filename}`];
}
---

<div class="flexor-concept">
  <p class="body-text">The concept began with a tendon-driven finger inspired by biomechanical cable systems. I sketched, modeled, and printed early prototypes to test motion, tension routing, and ergonomics using off-the-shelf parts and basic 3D printing.</p>

  <div class="image-grid">
    {img('Flexsketch@2x.webp') && <div class="img-sketch"><Image loading="lazy" src={img('Flexsketch@2x.webp')} alt="Hand sketch of prosthetic concept" width={500} /></div>}
    {img('FlexInitialRender@2x.webp') && <div class="img-render"><Image loading="lazy" src={img('FlexInitialRender@2x.webp')} alt="Initial CAD render" width={500} /></div>}
  </div>

  {img('FlexInitialModel@2x.webp') && (
    <div class="img-model">
      <Image loading="lazy" src={img('FlexInitialModel@2x.webp')} alt="Initial 3D printed model" width={600} />
    </div>
  )}
</div>

<style>
  .flexor-concept {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .body-text {
    font-weight: 200;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    line-height: 1.7;
    text-align: justify;
    max-width: 65ch;
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    align-items: center;
  }

  .image-grid img {
    width: 100%;
    height: auto;
  }

  .img-model {
    max-width: 50%;
    margin: 0 auto;
  }

  .img-model img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .image-grid {
      grid-template-columns: 1fr;
    }

    .img-model {
      max-width: 100%;
    }
  }
</style>
