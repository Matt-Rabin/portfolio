---
const fmt = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
});
const initial = fmt.format(new Date());
---

<span class="live-clock" data-initial={initial}>{initial} · Philadelphia, PA</span>

<script>
  const el = document.querySelector('.live-clock') as HTMLElement;
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/New_York',
    });
    const update = () => {
      el.textContent = fmt.format(new Date()) + ' · Philadelphia, PA';
    };
    update();
    setInterval(update, 60_000);
  }
</script>
